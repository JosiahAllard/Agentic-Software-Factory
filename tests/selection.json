{
  "comment": "tools/kit_tests.py --select: which kit tests a change runs (kitlib/tooldeps/selftree.py, docs/test-tools.md). A path selects the tests that read it; full lists only the table, the gate config and the code every test runs inside. A change to this file runs the full suite.",
  "full": [
    "tests/selection.json",
    ".kit.json",
    "tests/__init__.py",
    "kitlib/__init__.py",
    "kitlib/git/cmd.py",
    "kitlib/git/fake/**",
    "kitlib/tooldeps/pool_worker.py",
    "kitlib/tooldeps/pool.py",
    "kitlib/tooldeps/selfrun.py",
    "kitlib/tooldeps/childenv.py",
    "kitlib/tooldeps/selftree.py",
    "tools/kit_tests.py"
  ],
  "paths": [
    ["hosts/**", ["host"]],
    ["hosts.json", ["host"]],
    ["tests/host/fakehost/**", ["host"]],
    ["content/roles/**", ["content", "agents", "host"]],
    ["content/skills/**", ["content", "skills", "host"]],
    ["hosts/claude/adapter/**", ["content"]],
    ["hosts/claude/shell/agents/**", ["agents", "content"]],
    ["hosts/codex/**", ["codex"]],
    ["hosts/codex/adapter/**", ["content"]],
    ["hosts/codex/shell/agents/**", ["content"]],
    ["hosts/codex/shell/hooks-plugin/**", ["pluginsource", "guard"]],
    ["tests/codex/**", ["codex"]],
    ["hosts/__init__.py", ["host", "guard"]],
    ["hosts/claude/__init__.py", ["pmwatch", "guard"]],
    ["boot/**", ["boot", "guard", "host"]],
    ["kitlib/hookrun/**", ["host"]],
    ["boot/hook.py", ["codex", "pmstart", "coordinatorstart", "plugin", "machinesetup"]],
    ["kit.json", ["content", "host"]],
    [".claude-plugin/marketplace.json", ["content"]],
    ["hosts/claude/adapter/claude_host.py", ["pmwatch"]],
    ["hosts/claude/adapter/guard_selftest.py", ["guard"]],
    ["hosts/claude/adapter/host.py", ["guard", "pmstart", "coordinatorstart"]],
    ["hosts/claude/shell/hooks/hooks.json", ["plugin"]],
    [".claude-plugin/plugin.json", ["plugin"]],
    ["templates/**", ["templates", "skills"]],
    ["knowledge/**", ["knowledge"]],
    ["optional/bridge/**", ["bridge", "host"]],
    ["optional/**", ["optional", "knowledge", "skills"]],
    ["tests/optional/**", ["knowledge"]],
    ["tests/**", ["tooldeps"]],
    ["reserve_ui.pyw", ["lockui"]],
    ["tools/*.py", ["skills", "kitcmd", "tests.content.test_skill_commands"]],
    ["kitlib/hubsite/**", ["hubsite"]],
    ["kitlib/hubsite/web/**", ["hubsite"]],
    ["tests/hubsite/**", ["hubsite"]],
    ["tools/hub.py", ["hubsite"]],
    ["tools/_hub_args.py", ["hubsite"]],
    ["kitlib/hubjobs/**", ["hubjobs", "hubsite"]],
    ["tests/hubjobs/**", ["hubjobs", "hubsite"]],
    ["kitlib/**", ["skills"]],
    ["kitlib/**", ["tests.host.test_conformance_claude", "tests.host.test_conformance_codex", "tests.host.test_conformance_fake"]],
    ["docs/*.md", ["content"]],
    ["content/roles/*", ["launcher"]],
    ["hosts/*/shell/agents/*", ["launcher"]],
    ["content/skills/*/SKILL.md", ["docs"]]
  ],
  "prose": ["docs/**", "*.md", ".gitignore", ".claude/**"],
  "always": ["scrub", "platform", "ci", "tests.proc.test_spawn_sites", "tests.bridge.test_port", "tests.modulemap.test_kit_map"],
  "serial": [],
  "smoke": [
    "tests.guard.test_rules",
    "tests.guard.test_entry",
    "tests.guard.test_rolepolicy",
    "tests.guard.test_place",
    "tests.guard.test_shell",
    "tests.guard.test_selftest",
    "tests.landing.test_land",
    "tests.landing.test_land_selected",
    "tests.landing.test_verdicts",
    "tests.gate.test_detect",
    "tests.lock.test_api",
    "tests.lock.test_cli",
    "tests.lock.test_holds",
    "tests.lock.test_queue",
    "tests.ownerfiles.test_apply",
    "tests.commit.test_codex"
  ],
  "skip_fails": [
    ["tests.lock.test_slot_treekill", "the proof that kill_retry is not needed; its confine() skips when no fake cpu slot fits the gate's affinity, which would silently void it"],
    ["tests.lock.test_release_daemons", "the only proof that the kill path and the release spare a shared build daemon; ReleaseCase.setUp's confine() skips when no fake cpu slot fits the gate's affinity, which would silently void it"]
  ],
  "long": [
    "tests.docs.test_budget",
    "tests.backlog.test_store",
    "tests.landing.test_land_queue",
    "tests.syncbase.test_sync",
    "tests.landing.test_land_store",
    "tests.worktree.test_new_worktree",
    "tests.landing.test_hardening",
    "tests.worktree.test_worktree_remove"
  ]
}
